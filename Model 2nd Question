import csv

def more_general(h1, h2):
    return all(x=="?" or x==y for x,y in zip(h1,h2))

with open("scholarship.csv") as f:
    data=list(csv.reader(f))[1:]

S=["0","0","0"]
G=[["?","?","?"]]

for row in data:
    x=row[:-1]
    y=row[-1]

    if y=="Yes":
        for i in range(3):
            if S[i]=="0":
                S[i]=x[i]
            elif S[i]!=x[i]:
                S[i]="?"

        G=[g for g in G if more_general(g,S)]

    else:
        newG=[]
        for g in G:
            for i in range(3):
                if g[i]=="?":
                    new=g.copy()
                    new[i]=S[i]
                    newG.append(new)
        G=newG

print("Specific Hypothesis S:",S)
print("General Hypothesis G:",G)
