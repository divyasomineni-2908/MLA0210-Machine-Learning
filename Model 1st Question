import csv

with open("scholarship.csv") as f:
    data = list(csv.reader(f))

header = data[0]
rows = data[1:]

hypothesis = ["0"] * (len(header)-1)

for row in rows:
    if row[-1] == "Yes":
        for i in range(len(hypothesis)):
            if hypothesis[i] == "0":
                hypothesis[i] = row[i]
            elif hypothesis[i] != row[i]:
                hypothesis[i] = "?"

print("Final Hypothesis (Find-S):")
print(hypothesis)
